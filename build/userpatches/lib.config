# Late overrides for the generic UEFI VM target at the pinned Armbian revision.
DISTRO_GENERIC_KERNEL=yes
UEFI_ENABLE_BIOS_AMD64=no
UEFI_GRUB_DISTRO_NAME="Northforge OS"
UEFI_GRUB_TERMINAL="serial console"
UEFI_GRUB_TIMEOUT=0
SERIALCON="ttyS0"
CONSOLE_AUTOLOGIN=no
GRUB_CMDLINE_LINUX_DEFAULT="console=ttyS0,115200n8 ro panic=30"
ROOT_FS_LABEL="NF-ROOT"
UEFI_FS_LABEL="NF-BOOT"
