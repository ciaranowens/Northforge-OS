[Unit]
Description=Northforge isolated QEMU acceptance fixture (test images only)
After=local-fs.target
ConditionVirtualization=vm

[Service]
Type=oneshot
ExecStart=/usr/libexec/northforge-qemu-test
TimeoutStartSec=600
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
